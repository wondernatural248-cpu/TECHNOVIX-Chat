# ==============================================================================
# TECHNOVIX Chat - Supabase Environment Configuration
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Create a free project at https://supabase.com
# 2. In your Supabase Dashboard, navigate to:
#    Project Settings -> API (or Project Settings -> Configuration -> Data API)
# 3. Copy the "Project URL" and paste it as VITE_SUPABASE_URL below.
# 4. Copy the "anon public" API key (or publishable client key) and paste it as
#    VITE_SUPABASE_ANON_KEY below.
# 5. Execute the SQL script in `supabase/schema.sql` in the Supabase SQL Editor.
# 6. Copy this file to `.env.local` and restart Vite: `npm run dev`.
#
# SECURITY WARNING:
# NEVER place your Supabase `service_role` key in this file or any frontend code!
# The `anon` key is protected by PostgreSQL Row Level Security (RLS) policies.
# ==============================================================================

# Supabase Project URL (e.g. https://abcdefghijklm.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public API Key (safe to expose to browser client)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# App Metadata
VITE_APP_NAME="TECHNOVIX Chat"
VITE_APP_VERSION="1.0.0"
